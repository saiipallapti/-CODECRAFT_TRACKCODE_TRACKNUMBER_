<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CODSOFT Landing Page</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      line-height: 1.5;
      background-color: #ffffff;
    }

    nav {
      position: fixed;
      width: 100%;
      background: transparent;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 30px;
      z-index: 1000;
      transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    nav.scrolled {
      background-color: #1e1e1e;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    .logo {
      font-size: 22px;
      color: white;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .menu {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    .menu li a {
      color: white;
      text-decoration: none;
      font-size: 16px;
      padding: 6px 10px;
      border-radius: 4px;
      transition: 0.3s;
    }

    .menu li a:hover {
      background: #00bfff;
      color: white;
    }

    .hero {
      height: 90vh;
      background: linear-gradient(to right, #1e3c72, #2a5298);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 15px;
    }

    .hero h1 {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 17px;
      max-width: 500px;
      margin-bottom: 20px;
    }

    .btn {
      background: #00bfff;
      padding: 10px 20px;
      color: white;
      font-size: 15px;
      text-decoration: none;
      border-radius: 4px;
      transition: background 0.3s ease;
    }

    .btn:hover {
      background: #0099cc;
    }

    section {
      padding: 60px 30px;
      text-align: center;
    }

    #about,
    #projects,
    #contact {
      background: #f4f4f4;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 12px;
      color: #222;
    }

    section p {
      font-size: 16px;
      max-width: 700px;
      margin: auto;
      color: #333; /* Dark text for visibility */
    }

    footer {
      background: #1e1e1e;
      color: white;
      text-align: center;
      padding: 15px;
      font-size: 15px;
    }

    @media (max-width: 768px) {
      nav {
        padding: 12px 20px;
      }

      .menu {
        flex-direction: column;
        background: #1e1e1e;
        position: absolute;
        top: 60px;
        right: 20px;
        width: 180px;
        display: none;
        padding: 10px;
        border-radius: 8px;
      }

      .menu.active {
        display: flex;
      }

      .menu li {
        margin: 8px 0;
      }

      .toggle {
        display: block;
        font-size: 24px;
        color: white;
        cursor: pointer;
      }
    }

    .toggle {
      display: none;
    }
  </style>
</head>
<body>

  <nav id="navbar">
    <div class="logo">CODSOFT</div>
    <div class="toggle" onclick="toggleMenu()">☰</div>
    <ul class="menu" id="menu">
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <section class="hero" id="home">
    <h1>Welcome to CODSOFT</h1>
    <p>Your gateway to internships, learning, and real-world development experience.</p>
    <a href="#about" class="btn">Learn More</a>
  </section>

  <section id="about">
    <h2>About Us</h2>
    <p>CODSOFT is a platform for students and aspiring developers to gain hands-on experience in web development, data science, and more through internships and real projects.</p>
  </section>

  <section id="projects">
    <h2>Our Projects</h2>
    <p>We mentor students to build projects like calculators, portfolios, job portals, and even full-stack blogs using modern tech stacks.</p>
  </section>

  <section id="contact">
    <h2>Contact Us</h2>
    <p>Email: info@codsoft.in | Phone: +91-9999999999</p>
  </section>

  <footer>
    <p>&copy; 2025 CODSOFT. All rights reserved.</p>
  </footer>

  <script>
    // Scroll effect on navbar
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('navbar');
      nav.classList.toggle('scrolled', window.scrollY > 50);
    });

    // Toggle menu for mobile
    function toggleMenu() {
      const menu = document.getElementById('menu');
      menu.classList.toggle('active');
    }
  </script>
</body>
</html>
